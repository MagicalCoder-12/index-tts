  },
  {
    "file_name": "common_voice_te_43371587.wav",
    "sentence_id": 43371587,
    "text": "పది",
    "duration_ms": 2016
  },
  {
    "file_name": "common_voice_te_43371593.wav",
    "sentence_id": 43371593,
    "text": "గహనమెంత అగ్ని కణమదెంత",
    "duration_ms": 4248
  },
  {
    "file_name": "common_voice_te_43371594.wav",
    "sentence_id": 43371594,
    "text": "నీట కుంజరమును నిలబెట్టు మొసలిని",
    "duration_ms": 4068
  },
  {
    "file_name": "common_voice_te_43371595.wav",
    "sentence_id": 43371595,
    "text": "మంచి వాని మైత్రి మలయమారుత వీచి",
    "duration_ms": 4068
  },
  {
    "file_name": "common_voice_te_43371596.wav",
    "sentence_id": 43371596,
    "text": "ఫీజు చెల్లించిన రోజు నుంచి సంవత్సరం పాటు క్లాసులు వినొచ్చు",
    "duration_ms": 4608
  },
  {
    "file_name": "common_voice_te_43371597.wav",
    "sentence_id": 43371597,
    "text": "తగు నుపాయమున్న తప్పు నపాయంబు",
    "duration_ms": 4320
  },
  {
    "file_name": "common_voice_te_43371608.wav",
    "sentence_id": 43371608,
    "text": "సర్వగోళములను పాలించునది",
