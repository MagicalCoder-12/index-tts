  },
  {
    "file_name": "common_voice_te_43371479.wav",
    "sentence_id": 43371479,
    "text": "గెంత నేర్పు",
    "duration_ms": 3348
  },
  {
    "file_name": "common_voice_te_43371480.wav",
    "sentence_id": 43371480,
    "text": "విషయిజ్ఞానమని విభాగము",
