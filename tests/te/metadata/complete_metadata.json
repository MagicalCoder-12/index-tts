  },
  {
    "file_name": "common_voice_te_43371566.wav",
    "sentence_id": 43371566,
    "text": "కరుణశ్రీ",
    "duration_ms": 2736
  },
  {
    "file_name": "common_voice_te_43371567.wav",
    "sentence_id": 43371567,
    "text": "గుండ్లకమ్మ వాగులో ట్రాక్టర్ కొట్టుకుపోయింది",
