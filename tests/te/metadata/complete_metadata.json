  },
  {
    "file_name": "common_voice_te_43371508.wav",
    "sentence_id": 43371508,
    "text": "మాట",
    "duration_ms": 2196
  },
  {
    "file_name": "common_voice_te_43371509.wav",
    "sentence_id": 43371509,
    "text": "గాలి వేగం పెరిగింది",
