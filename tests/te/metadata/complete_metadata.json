  },
  {
    "file_name": "common_voice_te_43371570.wav",
    "sentence_id": 43371570,
    "text": "కష్టసాధ్యమైన కార్యమ్ము నెరవేర్ప",
    "duration_ms": 4068
  },
  {
    "file_name": "common_voice_te_43371571.wav",
    "sentence_id": 43371571,
    "text": "చదువొక్కటే కాదు ఆటలు కూడా ముఖ్యమే",
