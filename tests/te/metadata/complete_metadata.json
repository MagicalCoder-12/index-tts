  },
  {
    "file_name": "common_voice_te_43371577.wav",
    "sentence_id": 43371577,
    "text": "బాల బాలికలను",
    "duration_ms": 2808
  },
  {
    "file_name": "common_voice_te_43371583.wav",
    "sentence_id": 43371583,
    "text": "గురువారం నాకు ఏ పని లేదు",
    "duration_ms": 3636
  },
  {
    "file_name": "common_voice_te_43371584.wav",
    "sentence_id": 43371584,
    "text": "చెడ్డవాని చెలిమి చిచ్చువోలె",
    "duration_ms": 3276
  },
  {
    "file_name": "common_voice_te_43371585.wav",
    "sentence_id": 43371585,
    "text": "సిగ్గులేని కోతి మొగ్గలేసె",
    "duration_ms": 3240
  },
  {
    "file_name": "common_voice_te_43371586.wav",
    "sentence_id": 43371586,
    "text": "తల్లికాపాడునా",
