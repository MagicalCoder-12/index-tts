  },
  {
    "file_name": "common_voice_te_43371563.wav",
    "sentence_id": 43371563,
    "text": "ఘనత కూర్చు",
    "duration_ms": 3636
  },
  {
    "file_name": "common_voice_te_43371564.wav",
    "sentence_id": 43371564,
    "text": "కలసపాడు బ్రిడ్జిపై నుంచి నీరు ప్రవహించింది",
