  },
  {
    "file_name": "common_voice_te_43371452.wav",
    "sentence_id": 43371452,
    "text": "ధరణిలోపల నేను",
    "duration_ms": 3600
  },
  {
    "file_name": "common_voice_te_43371453.wav",
    "sentence_id": 43371453,
    "text": "ప్రకాశం బ్యారేజిలోకి వరద పోటెత్తుతోంది",
    "duration_ms": 4176
  },
  {
    "file_name": "common_voice_te_43371454.wav",
    "sentence_id": 43371454,
    "text": "భాష",
    "duration_ms": 1836
  },
  {
    "file_name": "common_voice_te_43371455.wav",
    "sentence_id": 43371455,
    "text": "గౌతమీ తరంగణీ తరంగములకు",
