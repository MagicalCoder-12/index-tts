[
  {
    "file_name": "common_voice_te_42973996.wav",
    "sentence_id": 42973996,
    "text": "కలసపాడు బ్రిడ్జిపై నుంచి నీరు ప్రవహించింది",
    "duration_ms": 6876
  },
  {
    "file_name": "common_voice_te_42973997.wav",
    "sentence_id": 42973997,
    "text": "స్ధిరమతులై సదాభజన సేయు మహాత్ముల పాదధూళి నా",
    "duration_ms": 10980
  },
  {
    "file_name": "common_voice_te_42973998.wav",
    "sentence_id": 42973998,
    "text": "మీడియాలు వంత పాడు చుండు",
    "duration_ms": 5220
  },
  {
    "file_name": "common_voice_te_42973999.wav",
    "sentence_id": 42973999,
    "text": "బోసు వీరుని క్రాంతి",
    "duration_ms": 4356
  },
  {
    "file_name": "common_voice_te_42974000.wav",
    "sentence_id": 42974000,
    "text": "ముందుచూపు లేని మూర్ఖుండు చెడిపోవు",
    "duration_ms": 5688
  },
  {
    "file_name": "common_voice_te_43371427.wav",
    "sentence_id": 43371427,
    "text": "పరిపూర్ణమై బట్టబయలుగాను",
    "duration_ms": 5688
  },
  {
    "file_name": "common_voice_te_43371428.wav",
    "sentence_id": 43371428,
    "text": "నీతిపరులు నిందింతురుగాక",
    "duration_ms": 4680
  },
  {
    "file_name": "common_voice_te_43371429.wav",
    "sentence_id": 43371429,
    "text": "నేడు, రేపు రాయలసీమలో భారీ వర్షాలు పడే అవకాశాలున్నాయి",
    "duration_ms": 6480
  },
  {
    "file_name": "common_voice_te_43371430.wav",
    "sentence_id": 43371430,
    "text": "కలిమి గలిగి",
    "duration_ms": 4140
  },
  {
    "file_name": "common_voice_te_43371431.wav",
    "sentence_id": 43371431,
    "text": "మా కళను గుర్తించి వాళ్ళు ఇక్కడికి రావడం ఎంతో ఆనందంగా ఉంటుంది.",
    "duration_ms": 6876
  },
  {
    "file_name": "common_voice_te_43371437.wav",
    "sentence_id": 43371437,
    "text": "పరమ సుందరంబు ఫలములు",
    "duration_ms": 3636
  },
  {
    "file_name": "common_voice_te_43371438.wav",
    "sentence_id": 43371438,
    "text": "పలురోగములకు నీ",
    "duration_ms": 3528
  },
  {
    "file_name": "common_voice_te_43371439.wav",
    "sentence_id": 43371439,
    "text": "రాజురాజు బిడ్డరా నేటి విద్యార్థి",
    "duration_ms": 4536
  },
  {
    "file_name": "common_voice_te_43371440.wav",
    "sentence_id": 43371440,
    "text": "ఏ మందహాసమువలన గొప్పదైన",
    "duration_ms": 4608
  },
  {
    "file_name": "common_voice_te_43371441.wav",
    "sentence_id": 43371441,
    "text": "తనకు తగని పిచ్చి పనులకు పోనేల",
